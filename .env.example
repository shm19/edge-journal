# Required: the password you log in with.
APP_PASSWORD=change-me
# Required in production: random string, 32+ chars (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Where the SQLite DB and screenshots live. In Docker this is /data (a volume).
DATA_DIR=./data
# Set to "false" only if you serve over plain HTTP (not recommended).
# COOKIE_SECURE=true
# Optional: where scripts/backup.sh writes backups (default ./backups).
# BACKUP_DIR=./backups
# Optional (docker-compose): container timezone for logs only — the app itself is always UTC.
# TZ=UTC
