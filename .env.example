# Required: the password you log in with.
APP_PASSWORD=change-me
# Required everywhere except `next dev` (the app refuses to start sessions without it): random string, 32+ chars (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Where the SQLite DB and screenshots live. In Docker this is /data (a volume).
DATA_DIR=./data
# Session cookie `Secure` flag: on in production; only an explicit "false" turns it off (plain-HTTP LAN, not recommended).
# In `next dev` it is off unless you set "true". Browsers accept Secure cookies on http://localhost.
# COOKIE_SECURE=true
# Optional: where scripts/backup.sh writes backups (default ./backups).
# BACKUP_DIR=./backups
# Optional (docker-compose): container timezone for logs only — the app itself is always UTC.
# TZ=UTC
