# Copy to .deploy.env (gitignored) in the repo root and fill in. Read by scripts/server.sh. Never put secrets here:
# the app password is asked for by `server.sh init` and sent over ssh stdin.

# The server you deploy to: user@host. The user needs sudo.
SERVER=you@203.0.113.10
SSH_PORT=22
# Optional: a specific private key (otherwise ssh uses its defaults / your agent).
#SSH_KEY=~/.ssh/id_ed25519

# Where the app listens on the server:
#   127.0.0.1  only reachable through `./scripts/server.sh tunnel` (recommended)
#   0.0.0.0    reachable from your network by IP (private network / LAN / VPN ONLY: the password travels over plain HTTP)
BIND=127.0.0.1
PORT=3000

# Off-site copies of the server's backups land here (`./scripts/server.sh pull-backups`).
#LOCAL_BACKUP_DIR=~/edge-journal-backups
